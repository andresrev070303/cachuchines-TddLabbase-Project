if [ "$HUSKY_SKIP_TRACK" = "1" ]; then
	exit 0
fi

node ./script/commitScript.js

REPO_DIR="$(git rev-parse --show-toplevel)"
node "$REPO_DIR/script/commit-tracker.js"

export HUSKY=0
git add script/commit-history.json
git add script/tdd_log.json
git commit --amend --no-edit 
unset HUSKY

# HU-07: el SHA definitivo existe después del amend. El envío nunca bloquea el commit.
node "$REPO_DIR/script/send-test-results.js" || echo "[HU-07] No se pudo ejecutar el envío; se conserva el respaldo local."
